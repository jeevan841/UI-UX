<html code:>


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aesthetic Webpage</title>
    <link rel="stylesheet" href="style.css">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&family=Playfair+Display:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>
    <header>
        <div class="container">
            <h1 class="logo">Your Brand</h1>
            <nav>
                <button class="hamburger" aria-label="Open navigation menu">&#9776;</button>
                <ul class="nav-links">
                    <li><a href="#home">Home</a></li>
                    <li><a href="#about">About</a></li>
                    <li><a href="#services">Services</a></li>
                    <li><a href="#contact">Contact</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main>
        <section id="hero" class="hero-section">
            <div class="container">
                <p>Welcome to a beautifully simple experience.</p>
                <h2>Crafting Digital Journeys</h2>
                <a href="#contact" class="btn">Get Started</a>
            </div>
        </section>

        <section id="about" class="content-section">
            <div class="container">
                <h3>Our Story</h3>
                <p>We believe in elegance and functionality. Our mission is to create spaces that resonate, whether they are digital or physical. With a keen eye for detail and a passion for thoughtful design, we bring your visions to life, ensuring every interaction is seamless and intuitive.</p>
                <p>From initial concept to final deployment, we prioritize clarity, aesthetics, and user experience above all else. Discover the difference intentional design can make.</p>
            </div>
        </section>

        <section id="services" class="content-section light-bg">
            <div class="container">
                <h3>What We Offer</h3>
                <div class="services-grid">
                    <div class="service-item">
                        <h4>Web Design</h4>
                        <p>Beautiful, responsive, and performance-driven websites crafted for every screen.</p>
                    </div>
                    <div class="service-item">
                        <h4>Branding</h4>
                        <p>Unique identities that capture your essence and speak to your audience.</p>
                    </div>
                    <div class="service-item">
                        <h4>Consulting</h4>
                        <p>Expert advice to navigate the complexities of digital presence.</p>
                    </div>
                </div>
            </div>
        </section>

        <section id="contact" class="content-section">
            <div class="container">
                <h3>Connect With Us</h3>
                <p>Ready to start your next project or simply have a question? We'd love to hear from you!</p>
                <form class="contact-form">
                    <input type="text" placeholder="Your Name" aria-label="Your Name">
                    <input type="email" placeholder="Your Email" aria-label="Your Email">
                    <textarea placeholder="Your Message" rows="5" aria-label="Your Message"></textarea>
                    <button type="submit" class="btn">Send Message</button>
                </form>
            </div>
        </section>
    </main>

    <footer>
        <div class="container">
            <p>&copy; 2023 Your Brand. All rights reserved.</p>
        </div>
    </footer>

    <script>
        document.querySelector('.hamburger').addEventListener('click', function() {
            document.querySelector('.nav-links').classList.toggle('active');
        });

        // Close nav when clicking outside on mobile
        document.querySelectorAll('.nav-links a').forEach(item => {
            item.addEventListener('click', () => {
                document.querySelector('.nav-links').classList.remove('active');
            });
        });
    </script>
</body>
</html>

<css>

/* --- Basic Reset & Font Imports --- */
@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&family=Playfair+Display:wght@400;700&display=swap');

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --color-cream: #F4F1BB;
    --color-blue-green: #9BC1BC;
    --color-red-orange: #ED6A5A;
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Montserrat', sans-serif;
}

body {
    font-family: var(--font-body);
    line-height: 1.6;
    color: var(--color-blue-green);
    background-color: var(--color-cream);
    scroll-behavior: smooth;
}

.container {
    max-width: 90%; /* Mobile first: narrower container */
    margin: 0 auto;
    padding: 1rem 0;
}

/* --- Typography --- */
h1, h2, h3, h4 {
    font-family: var(--font-heading);
    color: var(--color-blue-green);
    margin-bottom: 0.8em;
}

h1 { font-size: 2.2em; } /* Mobile default */
h2 { font-size: 1.8em; }
h3 { font-size: 1.5em; }
h4 { font-size: 1.2em; }

p {
    margin-bottom: 1em;
}

a {
    color: var(--color-blue-green);
    text-decoration: none;
}
a:hover {
    color: var(--color-red-orange);
}

.btn {
    display: inline-block;
    background-color: var(--color-red-orange);
    color: var(--color-cream);
    padding: 0.8em 1.5em;
    border-radius: 5px;
    margin-top: 1em;
    transition: background-color 0.3s ease;
}
.btn:hover {
    background-color: #e05e4e; /* Slightly darker red-orange for hover */
    color: var(--color-cream); /* Ensure text color stays readable */
}

/* --- Header & Navigation --- */
header {
    background-color: rgba(244, 241, 187, 0.9); /* Slightly transparent cream */
    padding: 1rem 0;
    border-bottom: 1px solid rgba(155, 193, 188, 0.3); /* Subtle border */
    position: sticky;
    top: 0;
    z-index: 1000;
}

header .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 1.8em;
    color: var(--color-red-orange);
    margin: 0;
}

.hamburger {
    display: block; /* Hamburger visible on mobile */
    background: none;
    border: none;
    font-size: 2em;
    color: var(--color-blue-green);
    cursor: pointer;
    padding: 0 10px;
}

.nav-links {
    display: none; /* Hidden by default on mobile */
    flex-direction: column;
    width: 100%;
    position: absolute;
    top: 100%;
    left: 0;
    background-color: var(--color-cream);
    border-top: 1px solid rgba(155, 193, 188, 0.3);
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

.nav-links.active {
    display: flex; /* Show when active */
}

.nav-links li {
    list-style: none;
    text-align: center;
    padding: 0.8rem 0;
    border-bottom: 1px solid rgba(155, 193, 188, 0.1);
}

.nav-links li:last-child {
    border-bottom: none;
}

.nav-links a {
    display: block;
    padding: 0.5rem 1rem;
    font-weight: 700;
    color: var(--color-blue-green);
}
.nav-links a:hover {
    background-color: rgba(237, 106, 90, 0.1); /* Light red-orange background */
}

/* --- Sections --- */
.content-section {
    padding: 4rem 0;
    text-align: center;
}

.hero-section {
    background-color: var(--color-cream);
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem 0;
}

.hero-section h2 {
    font-size: 2.5em; /* Mobile default */
    color: var(--color-red-orange);
    line-height: 1.2;
}

.hero-section p {
    font-size: 1.1em;
    color: var(--color-blue-green);
    margin-bottom: 1.5em;
}

.light-bg {
    background-color: #fcfaf0; /* Slightly lighter cream */
}

/* Services Grid (mobile-first: stacked) */
.services-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 2rem;
}

.service-item {
    background-color: #FFF; /* White background for service items */
    padding: 1.5rem;
    border-radius: 8px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    border: 1px solid rgba(155, 193, 188, 0.2);
}

.service-item h4 {
    color: var(--color-red-orange);
    margin-bottom: 0.5em;
}

/* Contact Form */
.contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 500px; /* Constrain form width */
    margin: 2rem auto 0 auto;
}

.contact-form input[type="text"],
.contact-form input[type="email"],
.contact-form textarea {
    padding: 1em;
    border: 1px solid var(--color-blue-green);
    border-radius: 5px;
    font-family: var(--font-body);
    font-size: 1em;
    background-color: #FFF; /* White background for inputs */
    color: var(--color-blue-green);
}

.contact-form input::placeholder,
.contact-form textarea::placeholder {
    color: rgba(155, 193, 188, 0.7);
}

.contact-form button.btn {
    width: 100%;
}

/* --- Footer --- */
footer {
    background-color: var(--color-blue-green);
    color: var(--color-cream);
    text-align: center;
    padding: 1.5rem 0;
    font-size: 0.9em;
}

/* --- Responsive Adjustments (Desktop/Tablet) --- */
@media (min-width: 768px) {
    .container {
        max-width: 80%; /* Wider container for tablets/desktops */
    }

    /* Header & Nav */
    .hamburger {
        display: none; /* Hide hamburger on larger screens */
    }

    nav .nav-links {
        display: flex; /* Always show nav links on larger screens */
        flex-direction: row;
        position: static; /* Reset positioning */
        width: auto;
        background-color: transparent;
        border-top: none;
        box-shadow: none;
    }

    .nav-links li {
        border-bottom: none;
        padding: 0 10px;
    }

    .nav-links li:last-child {
        margin-right: 0;
    }

    .nav-links a {
        padding: 0.5rem 0.8rem;
        color: var(--color-blue-green);
    }
    .nav-links a:hover {
        background-color: transparent;
        color: var(--color-red-orange);
    }

    /* Typography */
    h1 { font-size: 3.5em; }
    h2 { font-size: 2.8em; }
    h3 { font-size: 2.2em; }
    h4 { font-size: 1.5em; }

    .hero-section h2 {
        font-size: 3.5em;
    }

    /* Services Grid (multi-column) */
    .services-grid {
        flex-direction: row;
        flex-wrap: wrap; /* Allow items to wrap */
        justify-content: center;
        gap: 1.5rem;
    }

    .service-item {
        flex: 1 1 calc(33% - 1.5rem); /* Three items per row */
        max-width: calc(33% - 1.5rem);
    }
}

@media (min-width: 1024px) {
    .container {
        max-width: 1000px; /* Even wider for large desktops */
    }

    .service-item {
        flex: 1 1 calc(30% - 1.5rem); /* Slightly more spacious on large screens */
        max-width: calc(30% - 1.5rem);
    }
}
