<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Company Name — Luxury Dark</title>

  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --pink: #2a2a2a;
      --pink-mid: #c9a84f;   /* GOLD */
      --pink-dark: #a88c3a;

      --blue: #121212;
      --blue-mid: #1f1f1f;

      --text: #f5f5f5;
      --text-muted: #b0b0b0;

      --white: #0d0d0d;
      --off-white: #1a1a1a;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'DM Sans', sans-serif;
      color: var(--text);
      background: var(--white);
    }

    /* HEADER */
    .header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(18,18,18,0.9);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid #2a2a2a;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 18px 60px;
    }

    .logo {
      font-family: 'Playfair Display', serif;
      font-size: 1.5rem;
      font-weight: 700;
    }
    .logo span { color: var(--pink-mid); }

    .nav-menu { display: flex; gap: 30px; }

    .nav-link {
      text-decoration: none;
      color: var(--text-muted);
      font-size: 0.9rem;
      transition: 0.3s;
    }
    .nav-link:hover { color: var(--pink-mid); }

    .nav-cta {
      background: var(--pink-mid);
      color: black;
      padding: 8px 20px;
      border-radius: 30px;
      text-decoration: none;
      font-size: 0.85rem;
    }

    /* HERO */
    .hero {
      display: flex;
      align-items: center;
      padding: 80px 60px;
      gap: 40px;
    }

    .hero-content { flex: 1; }

    .hero h1 {
      font-family: 'Playfair Display', serif;
      font-size: 3rem;
      margin-bottom: 20px;
    }
    .hero h1 em { color: var(--pink-mid); }

    .hero p {
      color: var(--text-muted);
      margin-bottom: 30px;
      max-width: 500px;
    }

    .cta-button {
      background: var(--pink-mid);
      color: black;
      padding: 14px 30px;
      border-radius: 30px;
      text-decoration: none;
      font-weight: 500;
    }

    .hero-image {
      flex: 1;
      height: 350px;
      border-radius: 20px;
      background: linear-gradient(135deg, #1a1a1a, #2a2a2a);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .floating-card {
      background: #111;
      border: 1px solid #333;
      padding: 20px;
      border-radius: 16px;
      text-align: center;
    }

    .floating-card strong {
      color: var(--pink-mid);
      font-size: 1.8rem;
    }

    /* SECTIONS */
    section { padding: 80px 60px; }

    .section-title {
      font-family: 'Playfair Display', serif;
      text-align: center;
      margin-bottom: 40px;
      font-size: 2rem;
    }

    /* SERVICES */
    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px,1fr));
      gap: 20px;
    }

    .feature-item {
      background: var(--off-white);
      padding: 30px;
      border-radius: 15px;
      border: 1px solid #2a2a2a;
      transition: 0.3s;
    }
    .feature-item:hover {
      transform: translateY(-5px);
      border-color: var(--pink-mid);
      box-shadow: 0 10px 30px rgba(201,168,79,0.15);
    }

    .feature-item h3 { margin-bottom: 10px; }

    .feature-item p { color: var(--text-muted); }

    /* TESTIMONIAL */
    .testimonial-section {
      background: #111;
      text-align: center;
    }

    blockquote {
      font-family: 'Playfair Display';
      font-style: italic;
      margin: 20px auto;
      max-width: 600px;
    }

    /* PORTFOLIO */
    .portfolio-grid {
      display: grid;
      grid-template-columns: repeat(2,1fr);
      gap: 20px;
    }

    .portfolio-item {
      height: 200px;
      background: linear-gradient(135deg,#1a1a1a,#333);
      border-radius: 15px;
    }

    /* FOOTER */
    .footer {
      background: #111;
      padding: 40px;
      text-align: center;
    }

    .footer-logo span { color: var(--pink-mid); }

    .footer-copy {
      color: var(--text-muted);
      font-size: 0.8rem;
      margin-top: 10px;
    }

    /* MOBILE */
    @media(max-width:768px){
      .hero { flex-direction: column; }
      .portfolio-grid { grid-template-columns: 1fr; }
    }

  </style>
</head>

<body>

<header class="header">
  <div class="logo">Company<span>.</span></div>
  <nav class="nav-menu">
    <a href="#" class="nav-link">Home</a>
    <a href="#" class="nav-link">Services</a>
    <a href="#" class="nav-link">Portfolio</a>
    <a href="#" class="nav-cta">Contact</a>
  </nav>
</header>

<section class="hero">
  <div class="hero-content">
    <h1>Crafting Your Future with <em>Luxury Design</em></h1>
    <p>We create premium digital experiences that elevate your brand.</p>
    <a href="#" class="cta-button">Get Started</a>
  </div>

  <div class="hero-image">
    <div class="floating-card">
      <p>Clients</p>
      <strong>200+</strong>
    </div>
  </div>
</section>

<section>
  <h2 class="section-title">Our Services</h2>
  <div class="features-grid">
    <div class="feature-item">
      <h3>Web Development</h3>
      <p>Fast, responsive and premium websites.</p>
    </div>
    <div class="feature-item">
      <h3>Brand Identity</h3>
      <p>Luxury branding that stands out.</p>
    </div>
    <div class="feature-item">
      <h3>Marketing</h3>
      <p>Grow your business with smart strategy.</p>
    </div>
  </div>
</section>

<section class="testimonial-section">
  <blockquote>
    "Absolutely stunning design. Our brand now feels premium and powerful."
  </blockquote>
  <p>- CEO, Company</p>
</section>

<section>
  <h2 class="section-title">Portfolio</h2>
  <div class="portfolio-grid">
    <div class="portfolio-item"></div>
    <div class="portfolio-item"></div>
    <div class="portfolio-item"></div>
    <div class="portfolio-item"></div>
  </div>
</section>

<footer class="footer">
  <div class="footer-logo">Company<span>.</span></div>
  <p class="footer-copy">© 2025 Company. All rights reserved.</p>
</footer>

</body>
</html>
